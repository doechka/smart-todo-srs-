								"exec": [
									"// Тест 1: Проверяем статус код\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"// Тест 2: Проверяем что есть токен\r",
									"pm.test(\"Response has auth token\", function () {\r",
									"    var response = pm.response.json();\r",
									"    pm.expect(response.token).to.not.be.undefined;\r",
									"});\r",
									"\r",
									"// Тест 3: Сохраняем токен для других запросов\r",
									"pm.test(\"Save token to environment\", function () {\r",
									"    var response = pm.response.json();\r",
									"    pm.environment.set(\"auth_token\", response.token);\r",
									"    pm.environment.set(\"user_id\", response.user_id);\r",
									"    \r",
									"    console.log(\"Token saved:\", response.token);\r",
									"    console.log(\"User ID saved:\", response.user_id);\r",
									"});"
